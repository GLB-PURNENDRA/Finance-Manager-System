# ==============================================================
# Finance System Manager - Environment Variables Template
# Copy this file to .env or configure in your server/deployment environment
# ==============================================================

# Google Gemini API Key (Required for AI conversational features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_MODEL=gemini-3.5-flash-lite
GEMINI_API_TIMEOUT_SECONDS=30

# JWT Token Secret (256-bit key for production authentication)
JWT_SECRET=your_secure_256_bit_jwt_secret_hex_or_string_here

# MySQL Production Database (Optional - default uses embedded H2 in MySQL mode)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/finance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_database_password_here
